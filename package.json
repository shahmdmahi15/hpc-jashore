{
  "name": "hpc-jashore",
  "version": "0.1.55",
  "private": true,
  "description": "HPC Health & Pain Care Center, Jashore — realtime physiotherapy center management platform",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:api": "pnpm --filter @hpc/api dev",
    "dev:web": "pnpm --filter @hpc/web dev",
    "build": "pnpm --filter @hpc/api build && pnpm --filter @hpc/web build",
    "build:all": "pnpm -r build",
    "lint": "pnpm -r lint"
  }
}
