{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HPC Jashore",
  "version": "0.1.0",
  "identifier": "com.toufiquzzaman.hpc",
  "build": {
    "beforeDevCommand": "pnpm --filter @hpc/web dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter @hpc/web build",
    "frontendDist": "https://hpc.toufiquzzaman.com"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HPC Health & Pain Care Center — Jashore",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "opener": {},
    "notification": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGNkU4MzMwNjBGODJFRDIKUldUU0x2aGdNSU51YjR6Z0ttdFNRL1RoMXlxRUpwSVg2L2Z5TmVxa1A2dHl2NnpWZGVQWUxxNlUK",
      "endpoints": [
        "https://hpc.toufiquzzaman.com/api/updates/latest.json"
      ]
    }
  }
}
