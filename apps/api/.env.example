# Copy to .env (never commit real secrets)
PORT=4000
APP_VERSION=0.1.0-dev
NODE_ENV=development

# SQLite file (WAL mode). Single writer — API runs as ONE process (PM2 instances:1).
DATABASE_PATH=./data/hpc.db

# Generate strong secrets for production: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-insecure-secret-change-me
JWT_REFRESH_SECRET=dev-only-insecure-secret-change-me
GRANT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:3000
